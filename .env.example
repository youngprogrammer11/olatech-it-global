PORT=3000
MONGODB_URI=mongodb://localhost:27017/olatech
NODE_ENV=development

# Email config (for contact form notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_app_password
EMAIL_TO=info@olatechitglobal.com

# Admin and session security (set strong values in production; never commit real secrets)
SESSION_SECRET=
ADMIN_PASSWORD=
# Preferred alternative to ADMIN_PASSWORD: a bcrypt hash of the admin password
ADMIN_PASSWORD_HASH=
RESEND_API_KEY=
